# Demo data is in memory and resets on restart. Never use demo mode in production.
DEMO_MODE=true
PORT=4000
TRUST_PROXY_HOPS=0
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://waytohome:localdev@localhost:5432/waytohome?schema=public
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated verified Supabase user IDs, never browser-controlled roles.
ADMIN_USER_IDS=
TICKET_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
RESEND_API_KEY=
EMAIL_FROM=Way to Home <tickets@your-domain.lk>
# Generic JSON POST adapter: {to, message}. Adapt notifications.ts for your chosen provider.
SMS_API_URL=
SMS_API_TOKEN=
# PayHere Merchant API credentials for refunds (not the checkout merchant secret).
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
